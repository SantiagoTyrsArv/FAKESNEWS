# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

# ---- Entorno general ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Postgres ----
POSTGRES_USER=fakesnews
POSTGRES_PASSWORD=fakesnews
POSTGRES_DB=fakesnews
# DATABASE_URL la arma docker-compose.yml a partir de las 3 variables de arriba.
# Si corres la API fuera de Docker, exporta esta también:
# DATABASE_URL=postgresql+asyncpg://fakesnews:fakesnews@localhost:5432/fakesnews

# ---- Redis ----
# REDIS_URL=redis://localhost:6379/0

# ---- CORS (lista JSON de orígenes permitidos) ----
CORS_ORIGINS=["http://localhost:3000"]
# Dominio padre de las cookies de sesión cuando web y API usan subdominios
# distintos en producción (p. ej. .example.com). Vacío en local.
COOKIE_DOMAIN=
# Prefijo de ruta con que el navegador llega a la API (p. ej. /api si la web la
# hace de proxy con API_PROXY_TARGET). Vacío en local.
COOKIE_PATH_PREFIX=
# Proxies de la plataforma delante de la API que añaden a X-Forwarded-For; con
# ellos se obtiene la IP real del cliente para el rate limiting del login.
# 0 en local, 1 en Railway (también cuando la web hace de proxy).
TRUSTED_PROXY_HOPS=0
# Solo si la web hace de proxy de la API (API_PROXY_TARGET): el mismo valor en
# web y API. Con él la web demuestra que la IP del cliente que envía es suya.
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_PROXY_SECRET=

# ---- Auth / JWT ----
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MFA_PENDING_TOKEN_EXPIRE_MINUTES=5

# ---- TOTP (2FA) ----
# Clave Fernet de 32 bytes url-safe base64. Genera con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_SECRET_ENCRYPTION_KEY=change-me-fernet-key-32-bytes-b64==
TOTP_ISSUER_NAME=FakesNews

# ---- Rate limiting / lockout ----
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_VERIFY_PER_MINUTE=10

# ---- Anthropic / LLM ----
# Requerida a partir de la Fase 3 para verificación en vivo (opcional para tests, que mockean el cliente).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Transcripción de video ----
WHISPER_MODEL_SIZE=small
MAX_VIDEO_DURATION_SECONDS=600
# Lista blanca de hosts de video permitidos (protección SSRF: sin esto, yt-dlp
# intentaría extraer video de cualquier URL). Lista JSON; opcional, trae un
# valor por defecto razonable (YouTube, Vimeo, Dailymotion, TikTok).
# ALLOWED_VIDEO_HOSTS=["youtube.com","www.youtube.com","youtu.be"]

# ---- Límites del pipeline ----
MAX_TEXT_INPUT_CHARS=20000
MAX_CLAIMS_PER_SUBMISSION=8
VERIFY_CONCURRENCY_LIMIT=4
VERIFY_TIMEOUT_SECONDS=30

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
